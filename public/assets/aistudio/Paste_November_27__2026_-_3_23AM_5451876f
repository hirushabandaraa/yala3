  <script>
    (function () {
      var buttons = document.querySelectorAll('.filter-btn');
      var cards = document.querySelectorAll('.package-card');

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var filter = btn.getAttribute('data-filter');

          buttons.forEach(function (b) {
            b.classList.remove('bg-leopard-amber', 'text-on-leopard-amber');
            b.classList.add('bg-charcoal-elevated', 'border', 'border-charcoal-muted', 'text-on-charcoal-elevated');
          });
          btn.classList.remove('bg-charcoal-elevated', 'border', 'border-charcoal-muted', 'text-on-charcoal-elevated');
          btn.classList.add('bg-leopard-amber', 'text-on-leopard-amber');

          cards.forEach(function (card) {
            if (filter === 'all' || card.getAttribute('data-duration') === filter) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });
    })();
  </script>

